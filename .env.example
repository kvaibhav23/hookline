# ── LLM (set ONE; first one found is used) ─────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional overrides (defaults depend on provider — check your provider's current model names)
# LLM_PROVIDER=anthropic
# LLM_MODEL_FAST=
# LLM_MODEL_SMART=

# ── Search (Exa recommended; Tavily used as fallback) ──────────────
EXA_API_KEY=
TAVILY_API_KEY=

# ── Storage ────────────────────────────────────────────────────────
# Leave empty locally (uses .data/db.json). REQUIRED on Vercel: any Postgres URL (Neon / Supabase).
DATABASE_URL=

# ── Mock mode ──────────────────────────────────────────────────────
# Auto-on when keys are missing. Force with MOCK_MODE=1 (fictional sample data) or MOCK_MODE=0.
# MOCK_MODE=
